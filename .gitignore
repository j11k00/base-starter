.DS_Store
node_modules/
.vscode/.*

# Frontend
/public/assets/
/public/dist/
/public/*.zip

# Secrets — never commit. A .env in this repo's first history reached GitHub's
# push protection once already.
.env
.env.*
!.env.example

# Kirby
.dev
kirby
vendor

# Every plugin is composer-installed, base-kit included. Site-local plugins
# live in site/plugins/<sitename>/ and need an explicit exception here.
site/plugins/*

/public/media/*
!/public/media/index.html

/storage/accounts/*
!/storage/accounts/.gitkeep

/storage/cache/*
!/storage/cache/.gitkeep

/storage/logs/*
!/storage/logs/.gitkeep

/storage/sessions/*
!/storage/sessions/.gitkeep

/site/config/.license
/site/config/vite.config.php
# Generated by bnomei/kirby-mcp (composer dev dep); regenerate with the
# runtime-install tool. Not scaffold — would conflict on every version bump.
/site/commands/mcp/
