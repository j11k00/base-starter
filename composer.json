{
    "name": "muoto/base-starter",
    "description": "Kirby starter scaffold + base-kit dev harness",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "getkirby/cms": "^5.0.0",
        "muoto/base-kit": "*@dev"
    },
    "require-dev": {
        "bnomei/kirby-mcp": "^1.10"
    },
    "repositories": [
        {
            "comment": "Harness only: the kit is symlinked from the sibling checkout so edits are live. A real site replaces this with the vcs repo — see README.",
            "type": "path",
            "url": "../base-kit",
            "options": { "symlink": true }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "getkirby/composer-installer": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true
    },
    "extra": {
        "kirby-cms-path": "kirby"
    }
}
